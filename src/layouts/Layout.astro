---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { fonts } from '../data/fonts';

interface Props {
  title?: string;
  description?: string;
}

const { title = site.title, description = site.description } = Astro.props;
const fullTitle = title === site.title ? title : `${title} | ${site.title}`;
const googleFontQueries = [fonts.body.googleQuery, fonts.mono.googleQuery].filter(Boolean);
const fontHref = `https://fonts.googleapis.com/css2?${googleFontQueries
  .map((font) => `family=${font.replace(/ /g, '+')}`)
  .join('&')}&display=swap`;
const fontFamily = (font: { family?: string; name?: string; fallback?: string }) =>
  font.family ?? `'${font.name?.replace(/'/g, "\\'")}', ${font.fallback}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {googleFontQueries.length > 0 && <link href={fontHref} rel="stylesheet" />}
    <style define:vars={{
      fontBody: fontFamily(fonts.body),
      fontMono: fontFamily(fonts.mono),
    }}>
      :root {
        --font-body: var(--fontBody);
        --font-mono: var(--fontMono);
      }
    </style>

    <title>{fullTitle}</title>

    <!-- Theme initialization (dark-only UI; toggle code is kept in Navbar for future use) -->
    <script is:inline>
      document.documentElement.classList.add('dark');
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <Navbar />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
