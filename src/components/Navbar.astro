---
import { site } from '../data/site';

const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <nav class="site-nav" aria-label="Primary navigation">
    <div class="nav-inner">
      <a href="/" class="brand">{site.author}</a>

      <button id="mobile-menu-btn" class="menu-button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Toggle navigation">
        <span></span><span></span><span></span>
      </button>

      <div id="mobile-menu" class="nav-links">
        {site.navigation.map((item) => {
          const isExternal = 'external' in item && item.external;
          const isActive = !isExternal && (currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href)));
          return (
            <a
              href={item.href}
              class:list={["nav-link", { active: isActive }]}
              target={isExternal ? '_blank' : undefined}
              rel={isExternal ? 'noopener' : undefined}
            >
              {item.name}
            </a>
          );
        })}
        <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Switch to dark mode">
          <span id="theme-toggle-icon" aria-hidden="true">☾</span>
          <span id="theme-toggle-label">dark mode</span>
        </button>
      </div>
    </div>
  </nav>
</header>

<script>
  const button = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  button?.addEventListener('click', () => {
    const open = menu?.classList.toggle('open') ?? false;
    button.setAttribute('aria-expanded', String(open));
  });

  const themeToggle = document.getElementById('theme-toggle');
  const themeIcon = document.getElementById('theme-toggle-icon');
  const themeLabel = document.getElementById('theme-toggle-label');
  const updateThemeControl = () => {
    const isDark = document.documentElement.classList.contains('dark');
    themeIcon && (themeIcon.textContent = isDark ? '☀' : '☾');
    themeLabel && (themeLabel.textContent = isDark ? 'light mode' : 'dark mode');
    themeToggle?.setAttribute('aria-label', isDark ? 'Switch to light mode' : 'Switch to dark mode');
  };
  updateThemeControl();
  themeToggle?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
    updateThemeControl();
  });
</script>

<style>
  .site-header { background: var(--color-primary); }
  .site-nav { min-height: 58px; }
  .nav-inner { max-width: 1140px; min-height: 58px; margin: 0 auto; padding: 0 0.75rem; display: flex; align-items: center; gap: 2rem; }
  .brand { margin-right: auto; color: #fff; font-size: 1.1rem; font-weight: 700; text-decoration: none; }
  .brand:hover { color: #fff; }
  .nav-links { display: flex; align-items: center; gap: 1.25rem; }
  .nav-link { padding: 1rem 0; color: rgba(255, 255, 255, 0.8); font-size: 0.95rem; text-decoration: none; }
  .nav-link:hover, .nav-link.active { color: #fff; }
  .nav-link.active { border-bottom: 2px solid var(--color-accent); }
  .theme-toggle { display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.35rem 0.55rem; border: 1px solid rgba(255,255,255,0.45); border-radius: 0.25rem; background: transparent; color: rgba(255,255,255,0.85); font: inherit; font-size: 0.8rem; cursor: pointer; }
  .theme-toggle:hover { border-color: #fff; color: #fff; }
  .menu-button { display: none; padding: 0.4rem; border: 1px solid rgba(255,255,255,0.35); border-radius: 0.25rem; background: transparent; }
  .menu-button span { display: block; width: 1.2rem; height: 2px; margin: 3px; background: #fff; }

  @media (max-width: 767px) {
    .nav-inner { flex-wrap: wrap; padding: 0 1rem; }
    .menu-button { display: block; }
    .nav-links { display: none; flex-basis: 100%; flex-direction: column; align-items: flex-start; gap: 0; padding-bottom: 0.75rem; }
    .nav-links.open { display: flex; }
    .nav-link { width: 100%; padding: 0.55rem 0; }
    .nav-link.active { border-bottom: 0; }
    .theme-toggle { margin-top: 0.35rem; }
  }
</style>
