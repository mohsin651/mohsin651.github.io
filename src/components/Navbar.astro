---
import { site } from '../data/site';

const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <nav class="site-nav" aria-label="Primary navigation">
    <div class="container-page nav-inner">
      <a href="/" class="brand">{site.author}</a>

      <button id="mobile-menu-btn" class="menu-button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Toggle navigation">
        <span></span><span></span><span></span>
      </button>

      <div id="mobile-menu" class="nav-links">
        {site.navigation.map((item) => {
          const isExternal = 'external' in item && item.external;
          const isActive = !isExternal && (currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href)));
          return (
            <a
              href={item.href}
              class:list={["nav-link", { active: isActive }]}
              aria-current={isActive ? 'page' : undefined}
              target={isExternal ? '_blank' : undefined}
              rel={isExternal ? 'noopener' : undefined}
            >
              {item.name}{isExternal && <span class="external-arrow" aria-hidden="true">↗</span>}
            </a>
          );
        })}
        <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Switch to dark mode">
          <span id="theme-toggle-icon" aria-hidden="true">☾</span>
          <span id="theme-toggle-label">dark mode</span>
        </button>
      </div>
    </div>
  </nav>
</header>

<script>
  const button = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  button?.addEventListener('click', () => {
    const open = menu?.classList.toggle('open') ?? false;
    button.setAttribute('aria-expanded', String(open));
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menu?.classList.contains('open')) {
      menu.classList.remove('open');
      button?.setAttribute('aria-expanded', 'false');
      button?.focus();
    }
  });

  const themeToggle = document.getElementById('theme-toggle');
  const themeIcon = document.getElementById('theme-toggle-icon');
  const themeLabel = document.getElementById('theme-toggle-label');
  const updateThemeControl = () => {
    const isDark = document.documentElement.classList.contains('dark');
    themeIcon && (themeIcon.textContent = isDark ? '☀' : '☾');
    themeLabel && (themeLabel.textContent = isDark ? 'light mode' : 'dark mode');
    themeToggle?.setAttribute('aria-label', isDark ? 'Switch to light mode' : 'Switch to dark mode');
  };
  updateThemeControl();
  themeToggle?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    try { localStorage.setItem('theme', isDark ? 'dark' : 'light'); } catch {}
    updateThemeControl();
  });
</script>

<style>
  .site-header { border-bottom: 1px solid var(--color-border); background: var(--color-bg); }
  .site-nav { min-height: 58px; }
  .nav-inner { min-height: 58px; display: flex; align-items: center; gap: 2rem; }
  .brand { margin-right: auto; color: var(--color-text); font-size: 1.1rem; font-weight: 700; text-decoration: none; }
  .brand:hover { color: var(--color-accent); }
  .nav-links { display: flex; align-items: center; gap: 1.25rem; }
  .nav-link { display: inline-flex; align-items: center; gap: .25rem; min-height: 44px; position: relative; color: var(--color-text-muted); font-size: .86rem; text-decoration: none; }
  .nav-link:hover, .nav-link.active { color: var(--color-accent); }
  .nav-link.active::after { content: ''; position: absolute; bottom: 1px; left: 0; right: 0; height: 2px; background: var(--color-accent); }
  .external-arrow { font-size: .8rem; }
  .theme-toggle { display: inline-flex; justify-content: center; align-items: center; gap: .4rem; min-height: 44px; min-width: 44px; padding: .4rem .65rem; border: 1px solid var(--color-border); border-radius: var(--radius); background: var(--color-surface); color: var(--color-text-muted); font: inherit; font-size: .76rem; cursor: pointer; }
  #theme-toggle-icon { font-size: 1.1rem; line-height: 1; }
  #theme-toggle-label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  .theme-toggle:hover { border-color: var(--color-accent); color: var(--color-accent); background: var(--color-surface-soft); }
  .menu-button { display: none; width: 44px; height: 44px; padding: .5rem; border: 1px solid var(--color-border); border-radius: var(--radius); background: var(--color-surface); cursor: pointer; }
  .menu-button:hover { border-color: var(--color-accent); background: var(--color-surface-soft); }
  .menu-button span { display: block; width: 1.2rem; height: 2px; margin: 4px auto; background: var(--color-text); }

  @media (max-width: 900px) {
    .nav-inner { flex-wrap: wrap; gap: 0; min-height: 58px; }
    .menu-button { display: block; }
    .nav-links { display: none; flex-basis: 100%; flex-direction: column; align-items: stretch; gap: .25rem; padding: .5rem 0 1rem; border-top: 1px solid var(--color-border); }
    .nav-links.open { display: flex; }
    .nav-link { width: 100%; padding: .55rem .75rem; border-radius: var(--radius); }
    .nav-link.active { background: var(--color-surface-soft); }
    .nav-link.active::after { display: none; }
    .theme-toggle { align-self: flex-start; margin-top: .5rem; }
    #theme-toggle-label { position: static; width: auto; height: auto; clip-path: none; }
  }
</style>
