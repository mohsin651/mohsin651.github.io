---
import { site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container-page footer-inner">
    <span>© {year}, {site.author}</span>
    <span>Built with <a href="https://astro.build" target="_blank" rel="noopener">Astro</a>.</span>
  </div>
</footer>

<style>
  .site-footer { margin-top: auto; border-top: 1px solid var(--color-border); color: var(--color-text-subtle); font-size: 0.85rem; }
  .footer-inner { display: flex; justify-content: space-between; gap: 1rem; padding-top: 1.25rem; padding-bottom: 1.25rem; }
  @media (max-width: 575px) { .footer-inner { flex-direction: column; } }
</style>
