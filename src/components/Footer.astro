---
import { site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container-page footer-inner">
    <span>© {year} {site.author}</span>
    <div class="footer-links"><a href={`mailto:${site.email}`}>Get in touch <span aria-hidden="true">↗</span></a><span>Built with <a href="https://astro.build" target="_blank" rel="noopener">Astro</a></span></div>
  </div>
</footer>

<style>
  .site-footer { margin-top: auto; border-top: 1px solid var(--color-border); color: var(--color-text-subtle); font-size: .8125rem; }
  .footer-inner { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding-block: .75rem; }
  .footer-links { display: flex; align-items: center; gap: 1.5rem; }
  .footer-links a { display: inline-flex; gap: .4rem; align-items: center; min-height: 44px; }
  @media (max-width: 640px) { .footer-inner { flex-direction: column; align-items: flex-start; gap: .25rem; } }
</style>
