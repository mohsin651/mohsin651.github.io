---
import Layout from '../layouts/Layout.astro';
import { experiences } from '../data/experience';
---

<Layout title="experience" description="Experience and education of Mohsin Imam">
  <div class="container-page page-content">
    <div class="flex justify-between items-start gap-4 flex-wrap mb-8">
      <div>
        <h1 class="page-heading">Experience</h1>
        <p class="page-lede">Research, engineering, and applied machine learning.</p>
      </div>
      <a href="/pdf/cv_mohsin.pdf" target="_blank" rel="noopener" class="action-link">View resume</a>
    </div>

    <div class="stack">
      {experiences.map((exp) => (
        <article class="cv-entry">
          <h2>{exp.role}</h2>
          <p class="entry-meta">
            {exp.companyLink ? <a href={exp.companyLink} target="_blank" rel="noopener">{exp.company}</a> : exp.company}
            {' · '}{exp.type}{' · '}{exp.duration}{exp.location && ` · ${exp.location}`}
            {exp.supervisor && <> · Supervisor: {exp.supervisorLink ? <a href={exp.supervisorLink} target="_blank" rel="noopener">{exp.supervisor}</a> : exp.supervisor}</>}
          </p>
          <ul class="plain-list">
            {exp.bullets.map((bullet) => <li>{bullet}</li>)}
          </ul>
        </article>
      ))}
    </div>

  </div>
</Layout>
