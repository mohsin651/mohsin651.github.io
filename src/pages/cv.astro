---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { experiences } from '../data/experience';
---

<Layout title="Experience" description="Research and engineering experience of Mohsin Imam">
  <div class="container-page page-content">
    <PageHeader title="Experience" eyebrow="Professional journey" description="Research, engineering, and applied machine learning.">
      <a slot="action" href="/pdf/cv_mohsin.pdf" target="_blank" rel="noopener" class="action-link secondary">View resume <span aria-hidden="true">↗</span></a>
    </PageHeader>

    <div class="experience-list">
      {experiences.map((exp) => (
        <article class="cv-entry">
          <div class="experience-aside"><p class="entry-date">{exp.duration}</p><span class="tag">{exp.type}</span></div>
          <div>
          <h2>{exp.role}</h2>
          <p class="company-line">
            {exp.companyLink ? <a href={exp.companyLink} target="_blank" rel="noopener">{exp.company}</a> : exp.company}
          </p>
          {exp.location && <p class="entry-meta">{exp.location}</p>}
          {exp.supervisor && <p class="entry-meta">Supervisor: {exp.supervisorLink ? <a href={exp.supervisorLink} target="_blank" rel="noopener">{exp.supervisor}</a> : exp.supervisor}</p>}
          <ul class="plain-list">
            {exp.bullets.map((bullet) => <li>{bullet}</li>)}
          </ul>
          </div>
        </article>
      ))}
    </div>

  </div>
</Layout>
