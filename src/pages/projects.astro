---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';

const projects = [
  { title: 'QueriSight — Multimodal Video Retrieval', description: 'Designing a multimodal video retrieval pipeline that transforms videos into searchable, timestamped segments using scene-aware segmentation, keyframe extraction, SigLIP visual embeddings, and Qwen-generated descriptions.', tags: ['Video Retrieval', 'SigLIP', 'Qwen', 'FastAPI', 'Milvus'], link: '#', context: 'IPCV final project · Sep 2026 – Present · Supervisor: Fabien Baldacci', supervisorLink: 'https://www.labri.fr/en/profil/Baldacci_ID1346658490' },
  { title: 'Cross Modal Attention Bridge', description: 'Investigating CLIP interpretability through attention rollout, token filtering, and perturbation-based XAI methods including LIME, SHAP, and RISE.', tags: ['CLIP', 'XAI', 'LIME', 'SHAP', 'RISE'], link: 'https://github.com/mohsinppke/bmsp-fall25-mixed-signals', context: 'TRDP project · Nov 2025 – Present · Supervisor: Dr. Marcos Escudero-Viñolo' },
  { title: 'Individual HRV Response to Music via PPG', description: 'Designed a within-subjects PPG HRV study on music-induced autonomic modulation with Butterworth filtering, IBI extraction, FFT-PSD, and non-parametric statistical analysis.', tags: ['PPG', 'HRV', 'Signal Processing', 'Statistics'], link: '#', context: 'Sep 2025 – Dec 2025 · Supervisor: Dr. Márton Áron Goda', supervisorLink: 'https://ppke.hu/oktatok/goda-marton-aron-dr' },
  { title: 'Weighted Embeddings Fusion for Hate Detection', description: 'Designed an SE-based multimodal fusion model using CLIP, TweetEval, and EfficientNetB3 for meme classification, achieving SOTA performance with an F1 score of 92.5% on the MultiOFF and MAMI datasets.', tags: ['Multimodal', 'CLIP', 'TweetEval', 'EfficientNetB3'], link: 'https://github.com/mohsin651/DAMM', context: 'Sep 2024 – Jan 2025 · Supervisor: Dr. Ram Sarkar', supervisorLink: 'https://jadavpuruniversity.in/faculty-profile/ram-sarkar/' },
];
---

<Layout title="Projects" description="Selected projects by Mohsin Imam">
  <div class="container-page page-content">
    <PageHeader title="Projects" eyebrow="Selected work" description="Research and engineering across computer vision, multimodal learning, and applied AI." />

    <div class="project-grid">
      {projects.map((project, index) => (
        <article class="project-entry">
          <div class="project-topline"><span class="project-number">{String(index + 1).padStart(2, '0')}</span><span>{project.tags[0]}</span></div>
          <h2 class="entry-title">
            {project.link === '#' ? project.title : <a href={project.link} target="_blank" rel="noopener">{project.title}</a>}
          </h2>
          <p class="project-description">{project.description}</p>
          <div class="tag-list">
            {project.tags.map((tag) => <span class="tag">{tag}</span>)}
          </div>
          <div class="project-context">
            <p>{project.context}</p>
            {'supervisorLink' in project && project.supervisorLink && <a href={project.supervisorLink} target="_blank" rel="noopener">Supervisor profile ↗</a>}
          </div>
        </article>
      ))}
    </div>
  </div>
</Layout>
