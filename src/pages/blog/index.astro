---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title="Blog" description="Research notes and articles by Mohsin Imam">
  <div class="container-page page-content">
    <PageHeader title="Blog" eyebrow="Notes & ideas" description="Research notes, paper reviews, and technical writing." />

    {posts.length === 0 ? (
      <p class="empty-state">No posts yet. Check back soon.</p>
    ) : (
      <div>
        {posts.map((post) => (
          <article class="blog-entry">
            <time class="entry-date" datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}</time>
            <div>
            <h2 class="entry-title"><a href={`/blog/${post.slug}`}>{post.data.title}</a></h2>
            <p class="blog-description">{post.data.description}</p>
            {post.data.tags && <div class="tag-list">{post.data.tags.map((tag) => <span class="tag">{tag}</span>)}</div>}
            <a class="text-link" href={`/blog/${post.slug}`} aria-label={`Read ${post.data.title}`}>Read article <span aria-hidden="true">→</span></a>
            </div>
          </article>
        ))}
      </div>
    )}
  </div>
</Layout>
