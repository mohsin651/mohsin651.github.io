---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title="blog" description="Research notes and articles by Mohsin Imam">
  <div class="container-page page-content">
    <h1 class="page-heading">Blog</h1>
    <p class="page-lede">Research notes, paper reviews, and technical writing.</p>

    {posts.length === 0 ? (
      <p class="muted">No posts yet. Check back soon.</p>
    ) : (
      <div class="stack">
        {posts.map((post) => (
          <article class="blog-entry">
            <h2><a href={`/blog/${post.slug}`}>{post.data.title}</a></h2>
            <p class="entry-meta">{post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
            <p>{post.data.description}</p>
            {post.data.tags && <div class="tag-list">{post.data.tags.map((tag) => <span class="tag">{tag}</span>)}</div>}
          </article>
        ))}
      </div>
    )}
  </div>
</Layout>
