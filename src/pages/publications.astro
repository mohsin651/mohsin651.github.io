---
import Layout from '../layouts/Layout.astro';
import { papers } from '../data/papers';

function topicsFor(p: typeof papers[number]): string[] {
  const text = `${p.title} ${p.venue}`.toLowerCase();
  const topics: string[] = [];
  if (/(meme|multimodal|fusion)/.test(text)) topics.push('Multimodal');
  if (/(llm|prompt|language model|nlp|bert)/.test(text)) topics.push('LLM');
  if (/(rag|retrieval)/.test(text)) topics.push('RAG');
  if (/(cnn|image|vision|mri|alzheimer|skin|medical)/.test(text)) topics.push('Vision');
  if (/(blockchain|decentral)/.test(text)) topics.push('Blockchain');
  return topics.length ? topics : ['Other'];
}

const allTopics = Array.from(new Set(papers.flatMap(topicsFor))).sort();
const sorted = [...papers].sort((a, b) => b.year - a.year || Number(!!b.selected) - Number(!!a.selected));
const papersByYear = sorted.reduce((acc, paper) => {
  if (!acc[paper.year]) acc[paper.year] = [];
  acc[paper.year].push({ ...paper, _topics: topicsFor(paper) });
  return acc;
}, {} as Record<number, Array<typeof papers[number] & { _topics: string[] }>>);
const years = Object.keys(papersByYear).map(Number).sort((a, b) => b - a);
---

<Layout title="publications" description="Research publications by Mohsin Imam">
  <div class="container-page page-content">
    <h1 class="page-heading">Publications</h1>
    <p class="page-lede">{papers.length} publications and ongoing research.</p>

    <div class="filter-row" id="topic-filter" aria-label="Filter publications by topic">
      <button type="button" class="filter-button active" data-topic="all">all</button>
      {allTopics.map((topic) => <button type="button" class="filter-button" data-topic={topic}>{topic.toLowerCase()}</button>)}
    </div>

    {years.map((year) => (
      <section class="section-block year-section" data-year={year}>
        <h2 class="section-rule">{year}</h2>
        <div class="stack">
          {papersByYear[year].map((paper) => {
            const id = `abstract-${paper.title.replace(/[^a-zA-Z0-9]/g, '-').slice(0, 40)}`;
            return (
              <article class="paper-entry" data-topics={paper._topics.join(',')}>
                <h2>
                  {paper.link ? <a href={paper.link} target="_blank" rel="noopener">{paper.title}</a> : paper.title}
                </h2>
                <p class="entry-meta">{paper.authors}</p>
                <p class="entry-meta"><em>{paper.venue}</em>{paper.status && paper.status !== 'Published' && ` · ${paper.status}`}</p>
                <div class="tag-list">
                  {paper.link && <a href={paper.link} target="_blank" rel="noopener">read paper</a>}
                  {paper.pdf && <a href={paper.pdf} target="_blank" rel="noopener">pdf</a>}
                  {paper.abstract && <button type="button" class="filter-button abstract-toggle" data-target={id}>abstract</button>}
                </div>
                {paper.abstract && <div id={id} class="abstract" hidden>{paper.abstract}</div>}
              </article>
            );
          })}
        </div>
      </section>
    ))}
  </div>
</Layout>

<script>
  document.querySelectorAll<HTMLButtonElement>('.abstract-toggle').forEach((button) => {
    button.addEventListener('click', () => {
      const target = button.dataset.target;
      if (target) {
        const abstract = document.getElementById(target);
        if (abstract) abstract.hidden = !abstract.hidden;
      }
    });
  });

  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-button[data-topic]');
  const entries = document.querySelectorAll<HTMLElement>('.paper-entry');
  const sections = document.querySelectorAll<HTMLElement>('.year-section');
  buttons.forEach((button) => button.addEventListener('click', () => {
    const topic = button.dataset.topic;
    buttons.forEach((item) => item.classList.toggle('active', item === button));
    entries.forEach((entry) => {
      const topics = (entry.dataset.topics || '').split(',');
      entry.style.display = topic === 'all' || topics.includes(topic || '') ? '' : 'none';
    });
    sections.forEach((section) => {
      section.style.display = Array.from(section.querySelectorAll<HTMLElement>('.paper-entry')).some((entry) => entry.style.display !== 'none') ? '' : 'none';
    });
  }));
</script>
