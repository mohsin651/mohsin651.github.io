---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { existsSync } from 'node:fs';
import { papers } from '../data/papers';

function topicsFor(p: typeof papers[number]): string[] {
  const text = `${p.title} ${p.venue}`.toLowerCase();
  const topics: string[] = [];
  if (/(meme|multimodal|fusion)/.test(text)) topics.push('Multimodal');
  if (/(llm|prompt|language model|nlp|bert)/.test(text)) topics.push('LLM');
  if (/(rag|retrieval)/.test(text)) topics.push('RAG');
  if (/(cnn|image|vision|mri|alzheimer|skin|medical)/.test(text)) topics.push('Vision');
  if (/(blockchain|decentral)/.test(text)) topics.push('Blockchain');
  return topics.length ? topics : ['Other'];
}

const allTopics = Array.from(new Set(papers.flatMap(topicsFor))).sort();
const sorted = [...papers].sort((a, b) => b.year - a.year || Number(!!b.selected) - Number(!!a.selected));
const papersByYear = sorted.reduce((acc, paper) => {
  if (!acc[paper.year]) acc[paper.year] = [];
  acc[paper.year].push({ ...paper, _topics: topicsFor(paper) });
  return acc;
}, {} as Record<number, Array<typeof papers[number] & { _topics: string[] }>>);
const years = Object.keys(papersByYear).map(Number).sort((a, b) => b - a);
---

<Layout title="Publications" description="Research publications by Mohsin Imam">
  <div class="container-page page-content">
    <PageHeader title="Publications" eyebrow="Research" description="Papers, preprints, and ongoing work, organized by year and research topic." />

    <div class="filter-bar">
      <div class="filter-row" id="topic-filter" role="group" aria-label="Filter publications by topic">
        <button type="button" class="filter-button active" data-topic="all" aria-pressed="true">All topics</button>
        {allTopics.map((topic) => <button type="button" class="filter-button" data-topic={topic} aria-pressed="false">{topic}</button>)}
      </div>
      <p id="publication-count" class="result-count" role="status">{papers.length} publications</p>
    </div>

    {years.map((year) => (
      <section class="year-section" data-year={year} aria-labelledby={`year-${year}`}>
        <h2 class="year-heading" id={`year-${year}`}>{year}</h2>
        <div>
          {papersByYear[year].map((paper) => {
            const availablePdf = paper.pdf && (!paper.pdf.startsWith('/') || existsSync(new URL(`../../public${paper.pdf}`, import.meta.url)));
            return (
              <article class="paper-entry" data-topics={paper._topics.join(',')}>
                <h3 class="entry-title">
                  {paper.link ? <a href={paper.link} target="_blank" rel="noopener">{paper.title}</a> : paper.title}
                </h3>
                <p class="entry-meta">{paper.authors}</p>
                <p class="entry-meta">{paper.venue}</p>
                {paper.status && paper.status !== 'Published' && <div class="paper-status"><span class="tag">{paper.status}</span></div>}
                {(paper.link || availablePdf) && <div class="paper-actions">
                  {paper.link && <a class="text-link" href={paper.link} target="_blank" rel="noopener">Read paper <span aria-hidden="true">↗</span></a>}
                  {availablePdf && <a class="text-link" href={paper.pdf} target="_blank" rel="noopener">PDF <span aria-hidden="true">↗</span></a>}
                </div>}
                {paper.abstract && <details class="abstract-details"><summary>Abstract</summary><div class="abstract">{paper.abstract}</div></details>}
              </article>
            );
          })}
        </div>
      </section>
    ))}
  </div>
</Layout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-button[data-topic]');
  const entries = document.querySelectorAll<HTMLElement>('.paper-entry');
  const sections = document.querySelectorAll<HTMLElement>('.year-section');
  buttons.forEach((button) => button.addEventListener('click', () => {
    const topic = button.dataset.topic;
    buttons.forEach((item) => {
      item.classList.toggle('active', item === button);
      item.setAttribute('aria-pressed', String(item === button));
    });
    entries.forEach((entry) => {
      const topics = (entry.dataset.topics || '').split(',');
      entry.hidden = !(topic === 'all' || topics.includes(topic || ''));
    });
    sections.forEach((section) => {
      section.hidden = !Array.from(section.querySelectorAll<HTMLElement>('.paper-entry')).some((entry) => !entry.hidden);
    });
    const count = Array.from(entries).filter((entry) => !entry.hidden).length;
    const countLabel = document.getElementById('publication-count');
    if (countLabel) countLabel.textContent = `${count} publication${count === 1 ? '' : 's'}${topic !== 'all' ? ` · ${topic}` : ''}`;
  }));
</script>
